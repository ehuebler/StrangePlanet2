# Godot 4+ specific ignores
.godot/
/android/

# Shader lab screenshots
/dev/captures/

# Baked planet meshes, tens of megabytes and regenerable in seconds
/dev/exports/

# Blender auto-backups
*.blend1

# Python bytecode from the Blender authoring scripts
__pycache__/

# Regenerable asset intermediates and preview renders
/assets/work/*
!/assets/work/.gdignore
/assets/previews/*
!/assets/previews/.gdignore

# The GDExtension's dependency and its build leavings. The bindings are a clone
# of godot-cpp and the API dump is written by `godot --dump-extension-api`, so
# both are fetched rather than authored; see native/SConstruct. The built
# `bin/*.dll` is *not* ignored, because a clone with no compiler still has to run.
/native/godot-cpp/
/native/extension_api.json
/extension_api.json
/native/.sconsign.dblite
/native/src/*.obj
/native/src/*.obj.import
/bin/*.exp
/bin/*.lib
/bin/~*.TMP

# Baked patch cities — tens of GB, regenerable via dev/_bake_patch_cities.tscn
/assets/runtime/cities/

# Godot hot-reload copies of checked-in native binaries
/bin/~*.dll*
