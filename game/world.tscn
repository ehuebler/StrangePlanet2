; The flowers, over the shelf at Vacationer's Landing and out across the headland
; behind it. The field is grown from the species' `random_seed` and the height
; field alone, so it is the same on every peer, nothing about it is replicated
; or saved, and only the tiles near whoever is looking exist at any moment.
;
; `spread` is the planted ground and is much wider than anything is ever drawn
; at: what bounds the cost is the species' own draw distance, and this only says
; where the meadow stops. Walking out of it is walking off the edge of the
; flowers rather than watching them stop appearing.
[node name="LandingFlowers" type="Node3D" parent="Planet" unique_id=1704339834]
script = ExtResource("12_flowers")
direction = Vector3(-0.2881049, -0.1121179, 0.9510127)
species = Array[ExtResource("13_species")]([ExtResource("14_flower")])
spread = 430.0
tile_size = 34.0
clear_of = NodePath("../VacationersLanding")
additional_clear_of = Array[NodePath]([NodePath("../AbilityTestingSite")])
keep_back = 26.0
wind_heading = 35.0
; Temporarily disabled with the master aerial terrain wash. Ground-level bloom
; emission and the nearby real-light pool below remain active.
aerial_glow = false
; Six real, shadowless lights follow the nearest luminous flower patches. The
; blooms themselves all emit in the shader; this bounded pool is only what
; throws their dark-purple light onto the player, grass, and nearby props.
;
; The range is what makes the pool visible rather than the energy. Omni falloff
; reaches zero at the range, so an 8.5 m one placed on the nearest patch — which
; can be five metres off — was delivering almost nothing to the ground the
; player stands on. Thirty-four carries the bloom colour across a broad patch
; of terrain and onto the character and nearby props without adding more lights.
glow_light_limit = 6
glow_light_range = 34.0
glow_light_energy = 8.0
glow_light_height = 0.78
glow_light_use_region_color = false
glow_light_color = Color(0.3, 0.025, 0.68, 1)
glow_light_night_only = true
glow_light_pulse_amount = 0.16
glow_light_pulse_speed = 0.25
pending_limit = 1
applies_per_frame = 1

; Giant flower trees over the grassy country around Vacationer's Landing.
; Trunks and independently angled flowers are two MultiMeshes — two draw calls
; for the field — while one static body owns primitive trunk/crown collision for
; every tree. Placement asks GlobalGrass which terrain layer the ground shader
; paints, so a tree cannot grow in a green-looking patch of sand or stone.
[node name="LandingFlowerTrees" type="Node3D" parent="Planet"]
script = ExtResource("28_tree_field")
direction = Vector3(-0.2881049, -0.1121179, 0.9510127)
model = ExtResource("29_tree_model")
material = ExtResource("30_tree_material")
head_material = ExtResource("32_tree_head_material")
grass_cover = NodePath("../GlobalGrass")
clear_of = NodePath("../VacationersLanding")
additional_clear_of = Array[NodePath]([NodePath("../AbilityTestingSite")])
spread = 900.0
tree_count = 280
keep_back = 62.0
minimum_spacing = 22.0
minimum_height = 4.0
maximum_height = 11.5
; Temporarily disable only the high-altitude terrain stand-in. The crowns still
; glow and cast their pooled pink lights while the player is nearby.
orbital_glow = false
; Every crown emits after local sunset. These eight real lights are reassigned
; only among nearby trees and pulse on each tree's own phase, providing pink
; spill on the character and landscape without 280 simultaneous OmniLights.
; Six rather than eight. Both pools shine on the same grass, and a renderer only
; carries so many omni lights on one object before it starts dropping them,
; which shows up as patches of ground changing brightness as the player walks.
night_light_limit = 6
; A crown sits seven to eleven metres up, so part of this range is spent getting
; back down to the grass. Fifty carries a strong pool of pink beyond the crown
; and onto nearby terrain, characters, equipment, and props.
night_light_range = 50.0
night_light_energy = 9.0
night_light_color = Color(1, 0.055, 0.32, 1)
night_light_pulse_amount = 0.13
night_light_pulse_speed = 0.22

; Grass uses the same tiled MultiMesh machinery as the flowers, but its tile
; keys cover all six cube faces and are enumerated around the current viewer.
; Nothing is allocated for the rest of the planet.
[node name="GlobalGrass" type="Node3D" parent="Planet"]
script = ExtResource("12_flowers")
direction = Vector3(-0.2881049, -0.1121179, 0.9510127)
species = Array[ExtResource("13_species")]([ExtResource("15_grass")])
global_cover = true
tile_size = 18.0
clear_of = NodePath("../AbilityTestingSite")
keep_back = 18.0
wind_heading = 35.0
pending_limit = 1
applies_per_frame = 1
survey_interval = 0.3
; Broad, low-frequency fill carries the coherent patch glow onto the terrain.
; This is intentionally stronger than the blade emission: raster emission does
; not illuminate nearby surfaces, and asking every sub-pixel blade to look
; bright enough on its own is what turns a lawn into static.
glow_light_limit = 10
glow_light_range = 28.0
glow_light_energy = 4.0
; Above the blades rather than among their tips. A grazing light mostly catches
; vertical grass and contributes almost nothing to a horizontal terrain normal;
; this height turns the same bounded pool into a soft patch of ground fill.
glow_light_height = 1.4

; A separate low-cost grass horizon. The dense twenty-blade field above still
; owns the nearest 48 m; this eight-blade field streams five times farther at a
; fraction of its density. Keeping the streams separate means the dense field
; does not allocate full-density buffers for hundreds of distant tiles merely
; to hide almost every instance through thinning.
[node name="GlobalDistantGrass" type="Node3D" parent="Planet"]
script = ExtResource("12_flowers")
direction = Vector3(-0.2881049, -0.1121179, 0.9510127)
species = Array[ExtResource("13_species")]([ExtResource("27_grass_distant")])
global_cover = true
tile_size = 30.0
wind_heading = 35.0
pending_limit = 1
applies_per_frame = 1
survey_interval = 0.4
glow_light_limit = 0

; The reef, on the same machinery as the grass and streamed the same way: four
; corals whose depth rule puts them on the sunlit sand between eight and thirty
; metres down and nowhere else. Nothing here knows about the ocean — the band is
; two numbers on each species and the sea bed is sand because the terrain
; shader's own rules say a shore is, so this is a GroundCover with a different
; sign on its heights.
;
; The wind heading matches the grass on purpose. Wind is published as a shader
; global by whichever field writes it last, so two fields with different
; headings is one planet whose breeze depends on the node order.
[node name="Reef" type="Node3D" parent="Planet"]
script = ExtResource("12_flowers")
direction = Vector3(-0.2881049, -0.1121179, 0.9510127)
species = Array[ExtResource("13_species")]([ExtResource("20_coral_pink"), ExtResource("21_coral_blue"), ExtResource("22_coral_purple"), ExtResource("23_coral_green")])
global_cover = true
tile_size = 30.0
wind_heading = 35.0
push_reach = 2.2
pending_limit = 1
applies_per_frame = 1
survey_interval = 0.5
; Coral's shader emission makes the heads visible; these ten pooled lights are
; what make that emission fall onto the sand, nearby coral, the swimmer and
; equipment. The pool is bounded no matter how much reef is streamed.
glow_light_limit = 10
glow_light_range = 26.0
glow_light_energy = 6.0
glow_light_height = 0.9
glow_light_use_region_color = false
glow_light_color = Color(0.4, 0.2, 0.8, 1)
glow_light_night_only = true
glow_light_pulse_amount = 0.12
glow_light_pulse_speed = 0.16

; The planet-wide multi-biome library. Its five internal GroundCover fields
