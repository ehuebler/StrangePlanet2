[node name="Sun" type="DirectionalLight3D" parent="." unique_id=1310562230]
; CelestialCycle rewrites this transform on every rendered frame. Interpolation
; exists to smooth transforms that only advance on physics ticks, so applying it
; to one that is already authored per frame can only hold the light a tick
; behind where the cycle has put it.
physics_interpolation_mode = 2
; The same sun, in the other hemisphere's summer. It was 17.3 degrees south of
; the equator, and the pole's horizon *is* the equatorial plane, so the arctic sat
; in permanent polar night: a black disc from orbit and a blue dusk on the ground,
; however white PlanetShape painted it. Mirrored rather than raised, so the sun is
; exactly as high as the rest of the world was lit and tuned under — only its
; declination changed sign. `dev/_arctic_test.gd` reports the angle.
;
; Godot writes a Transform3D's basis as **rows**, so the declination is the third
; number of the second triple and not of the third. Two attempts at this went the
; wrong way for want of knowing that.
transform = Transform3D(0.92202, -0.11511, 0.3695, 0, 0.95466, 0.29744, -0.38701, -0.27425, 0.8803, 0, 0, 0)
light_color = Color(1, 0.96, 0.9, 1)
light_energy = 1.05
; How far the shadow lookup steps along the surface normal before reading the
; map, in texels of whichever cascade it lands in.
;
; The engine default of 2 is set for rooms and props. The smallest thing here is
; the player, and it is the one thing in the game narrower than a handful of
; shadow texels: a head is about a dozen of them across, so the depth the map
; holds for it is a coarse staircase, and wherever the body faces the sun
; obliquely it reads back as being behind its own recorded depth and shades
; itself in hard black patches — the crown under the hair, the gap between an
; arm and the ribs, the top of a boot. Flying is where it shows worst, because
; the field of view opens to 81 degrees and every cascade widens with it, and
; because the patches then crawl over the body as the camera moves.
;
; 4 is the smallest value that clears it: measured by flying past the ground and
; differencing consecutive frames over the body, which at 2 changes across whole
; limbs and at 4 only along the silhouette, matching a body that casts no shadow
; at all. Going further would start pulling contact shadows off their casters,
; and buys nothing.
shadow_normal_bias = 4.0
shadow_enabled = true
; Taps the shadow comparison takes, not a softness dial — and at zero, which is
; where this shipped, it takes one. A single hard comparison per pixel delivers
; whatever acne the biases above fail to prevent at full contrast, and re-rolls
; it every time the map is rasterised again, which is every frame: CelestialCycle
; rewrites this light's transform per frame, so the ground boiled.
;
; It only showed at the start of a game, and that is not a coincidence. The
; engine scales shadow_normal_bias by `1 - dot(light, -normal)`, so head-on to a
; surface the four texels bought above are worth exactly nothing; phase zero is
; noon over the landing site, so every game opens with the sun within eight
; degrees of the zenith and the terrain unprotected. `--boot` measures it: at the
; spawn angle 43% of the ground changed by more than the eye forgives every
; frame, half of that was gone by thirty seconds and all of it by sixty, as the
; sun tilted and the normal bias came back. That is the "flicker that fades after
; a minute" exactly.
;
; Nothing else touches it. Twenty times the depth bias moves it by nothing, and
; switching off every caster on the planet — 670 terrain surfaces and 349 other
; things — leaves the picture pixel-for-pixel as speckled, because an unfiltered
; comparison against an empty map is still an unfiltered comparison. 0.25 is
; already at the noise floor and the engine's own 1.0 is indistinguishable from
; 0.0 on the afternoon shadows and the body's contact shadow, so this takes the
; default and the margin with it.
shadow_blur = 1.0
; Where the four cascades hand over, as fractions of the 150 m below. Pulling
; the first break in from the default 0.1 spends the nearest cascade on the 5 m
; around the camera rather than on 15 m, which is a third of the texel size over
; the player and is what lets the bias above stay as low as 4.
;
; The cost is a seam where one cascade meets the next, and at 5 m that seam
; lands about where a third-person camera is pointed, so they are blended.
directional_shadow_split_1 = 0.035
directional_shadow_split_2 = 0.12
directional_shadow_split_3 = 0.4
directional_shadow_blend_splits = true
directional_shadow_max_distance = 150.0

; The planet does not rotate. The light and procedural star field make one turn
; around its north-pole/cloud-circle axis every sixteen minutes instead, with
; Vacationer's Landing under the phase-zero noon. Because the orbit has zero
; declination, the terminator always bisects the ice cap.
;
; `node_paths` is not decoration. Exports typed as a node rather than as a
; NodePath are stored here as a path and resolved after the whole scene exists,
; and this array is what marks them for that resolution. Without it the loader
; tries to assign a NodePath straight into a typed property, the assignment is
; dropped, and every one of the four arrives null — which is exactly how this
; cycle spent its life pushing "needs its planet and directional sun" and
; switching its own processing off.
[node name="CelestialCycle" type="Node" parent="." node_paths=PackedStringArray("planet", "sun", "world_environment", "noon_anchor")]
script = ExtResource("31_cycle")
planet = NodePath("../Planet")
sun = NodePath("../Sun")
world_environment = NodePath("../WorldEnvironment")
noon_anchor = NodePath("../Planet/VacationersLanding")
period_seconds = 960.0

[node name="NightGroundGlow" type="Node3D" parent="." node_paths=PackedStringArray("planet", "cycle")]
script = ExtResource("47_night_ground_glow")
planet = NodePath("../Planet")
cycle = NodePath("../CelestialCycle")
; Four shadowless lights follow the local viewer and sample the exact shader
; field beneath them. This is the bounded fake for emissive terrain bounce:
; enough to colour a character and nearby props, never a light per world patch.
light_limit = 4
light_range = 68.0
light_energy = 2.0
light_height = 7.0
light_ring_radius = 26.0

[node name="Planet" type="Node3D" parent="." node_paths=PackedStringArray("sun") unique_id=1088204411]
script = ExtResource("5_planet")
shape = SubResource("PlanetShape_world")
; Start orbital views at depth-4 grain. Depths 0 through 3 still exist as broad
; fallback chunks, but carry enough vertices to depict the same 49 m surface
; grain, so the globe already has hills and a stable silhouette at the outer-
; space spawn instead of waiting until the player has crossed the atmosphere.
; This raises only the shallow fallback meshes; max_depth and the 1.5 m
; walkable grain are unchanged.
far_detail_depth = 4
; Keep the next refinement level visible from about ten percent farther away.
; Cost grows with area, so 2.2 is deliberately modest: enough to stop low,
; horizontal flight riding the boundary between two levels without turning the
; normal setting into the existing 1.6x Far setting.
split_ratio = 2.2
; Left unset, the planet publishes no sun_direction at all and every shader that
; wants a day/night term falls back to the value declared in project.godot —
; which is a static guess and had the declination above already reversed under
; it. What that bought was a game where the sea glinted, the clouds lit and the
; air's limb glowed on the hemisphere facing away from the light, while Godot's
; own shading of the ground got it right, so the two disagreed by a hemisphere.
; The harnesses never saw it because each of them assigns this itself.
sun = NodePath("../Sun")

