[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMaterial")
; The celestial angle changes continuously. Incremental mode restarts its
; multi-frame radiance bake whenever that angle changes, which produced the
; regular whole-frame holds visible while walking. Realtime mode is the path
; intended for a dynamic sky and spreads that cost evenly.
process_mode = 3

; Typed as the engine class with the script attached, rather than by the script's
; own `GodRaysEffect` global name. A global class name is resolved out of a cache
; that is not yet populated the first time the project is scanned, and this scene
; is loaded during that scan; the engine class always exists.
[sub_resource type="CompositorEffect" id="GodRays_world"]
script = ExtResource("44_god_rays")
; CelestialCycle overwrites `enabled` from the player's setting on the first
; frame. It ships on so that the editor and the harnesses that load this scene
; without a SettingsManager see the effect.
enabled = true
strength = 0.45
density = 0.96
decay = 0.975
halo = 0.3
reach = 1.3
veil_near = 25.0
veil_far = 400.0

[sub_resource type="Compositor" id="Compositor_world"]
compositor_effects = Array[CompositorEffect]([SubResource("GodRays_world")])

[sub_resource type="Environment" id="Environment_world"]
background_mode = 2
sky = SubResource("Sky")
; The visible sky is dynamic, but rebuilding its radiance cubemap as an ambient
; and reflection source while walking causes frame-time spikes. A softly blue
; ambient is modulated by CelestialCycle instead; the sky itself still moves.
ambient_light_source = 2
ambient_light_color = Color(0.72, 0.8, 1, 1)
ambient_light_energy = 0.38
reflected_light_source = 1
tonemap_mode = 3
tonemap_white = 2.0
glow_enabled = true
glow_intensity = 0.7
glow_hdr_threshold = 0.95

